# External backend API base URL, e.g. https://api.example.com
# Used for public development data and enquiry submissions.
VITE_API_BASE_URL=

# Analytics — leave unset to log events to the browser console only.
# Stable unique identifier for this website in a shared analytics database.
VITE_ANALYTICS_SITE_ID=quo-public-website
# Backend endpoint that accepts POST { events: AnalyticsEvent[] } (see src/analytics/types.ts).
VITE_ANALYTICS_ENDPOINT=
# GA4 measurement id, e.g. G-XXXXXXXXXX. gtag is loaded automatically when set.
VITE_GA_MEASUREMENT_ID=
