# Vite only exposes VITE_* variables, and bakes them into the build — rebuild after changing them.

# citadel-api host, e.g. https://citadel-api.kojoansah.workers.dev (/api/v1 is added automatically).
# Leave empty to show the built-in content from data/portfolio.json.
VITE_API_BASE_URL=
# This website's id on the backend (sent as the X-Website-Id header).
VITE_WEBSITE_ID=quoec
# "seed" shows data/portfolio.json when the API is unset or unreachable; "none" shows nothing.
VITE_CONTENT_FALLBACK=seed

# Analytics — events go to <VITE_API_BASE_URL>/api/v1/public/analytics/events automatically when the API is set,
# tagged with VITE_WEBSITE_ID. Without an API they are only logged to the browser console.
# Override the address here, or set "off" to keep events in the console.
VITE_ANALYTICS_ENDPOINT=
# GA4 measurement id, e.g. G-XXXXXXXXXX. gtag is loaded automatically when set.
VITE_GA_MEASUREMENT_ID=

# ── Seed script only (scripts/seed-production.py). Never prefixed VITE_ — these must not reach the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
